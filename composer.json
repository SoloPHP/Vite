{
  "name": "solophp/vite",
  "type": "library",
  "description": "Vite for PHP without a framework: the tags that load entries from the dev server or the build manifest, with a Twig function.",
  "keywords": [
    "php",
    "vite",
    "manifest",
    "assets",
    "hmr",
    "twig",
    "inertia"
  ],
  "homepage": "https://github.com/SoloPHP/Vite",
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/SoloPHP/Vite/issues",
    "source": "https://github.com/SoloPHP/Vite"
  },
  "autoload": {
    "psr-4": {
      "Solo\\Vite\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\Vite\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "squizlabs/php_codesniffer": "^4.0",
    "twig/twig": "^3.27"
  },
  "suggest": {
    "twig/twig": "For the vite() Twig function (Twig 3)"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "cs": "phpcs",
    "cs-fix": "phpcbf",
    "check": [
      "@composer validate --strict",
      "@cs",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
